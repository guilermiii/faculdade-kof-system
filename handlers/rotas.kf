package handlers

import models.*

// ============================================================================
// Registro Compartilhado de Rotas HTTP (usado por app.kf e pelos testes E2E)
// ============================================================================

registrarRotas(kof.web.App app, String conn, String oauthProvider) {
    // Serve o Frontend KOF Web compilado (--target js) em /ui (RNF01, RNF06)
    app.serveDir("/ui", "public")

    app.get("/") {
        setHeader("Content-Type", "text/html; charset=utf-8")
        return "<!DOCTYPE html><html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><meta name=\"service\" content=\"kof-gado-api\" data-ui=\"/ui\"><meta http-equiv=\"refresh\" content=\"0; url=/ui/\"><title>AgroKOF — Gestão Pecuária</title><script>window.location.replace('/ui/');</script></head><body style=\"background:#0b1120;color:#f8fafc;font-family:system-ui,sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;margin:0\">Redirecionando para o AgroKOF Dashboard (<a href=\"/ui/\" style=\"color:#10b981\">/ui</a>)...</body></html>"
    }

    app.get("/api") {
        return "{\"service\":\"kof-gado-api\",\"status\":\"OK\",\"ui\":\"/ui\"}"
    }

    // Healthcheck da API
    app.get("/health") {
        return "{\"status\":\"UP\",\"service\":\"kof-gado-api\"}"
    }

    // ------------------------------------------------------------------------
    // RF04 - Gestao do Perfil do Usuario (OAuth2 - RNF08/RNF09)
    // ------------------------------------------------------------------------
    app.get("/perfil") {
        if (!auth.authenticated()) {
            return status(401, "{\"error\":\"Autenticacao OAuth2 obrigatoria (Google/GitHub)\"}")
        }
        return obterOuCriarPerfil(conn, auth.user(), oauthProvider)
    }

    app.put("/perfil") {
        if (!auth.authenticated()) {
            return status(401, "{\"error\":\"Autenticacao OAuth2 obrigatoria (Google/GitHub)\"}")
        }
        return atualizarPerfil(conn, auth.user(), oauthProvider, body())
    }

    // ------------------------------------------------------------------------
    // RF02 - Cadastrar, Editar e Consultar Pastos
    // ------------------------------------------------------------------------
    app.get("/pastos") {
        return listarPastos(conn)
    }

    app.get("/pastos/:id") {
        return buscarPastoPorId(conn, param("id"))
    }

    app.post("/pastos") {
        return status(201, criarPasto(conn, body()))
    }

    app.put("/pastos/:id") {
        return atualizarPasto(conn, param("id"), body())
    }

    // ------------------------------------------------------------------------
    // RF01 - Cadastrar e Gerenciar Gado (CRUD) + RF07 - Filtragem por Pasto
    // ------------------------------------------------------------------------
    app.get("/gados") {
        return listarGados(conn)
    }

    app.get("/gados/:id") {
        return buscarGadoPorId(conn, param("id"))
    }

    app.get("/pastos/:pastoId/gados") {
        return filtrarGadoPorPasto(conn, param("pastoId"))
    }

    app.post("/gados") {
        return status(201, criarGado(conn, body()))
    }

    app.put("/gados/:id") {
        return atualizarGado(conn, param("id"), body())
    }

    app.delete("/gados/:id") {
        var removido = removerGado(conn, param("id"))
        if (!removido) {
            return null
        }
        return "{\"deleted\":true}"
    }

    // ------------------------------------------------------------------------
    // RF03 - Medicamentos + RF06 - Consulta e Controle de Estoque
    // ------------------------------------------------------------------------
    app.get("/remedios") {
        return listarRemedios(conn)
    }

    app.get("/remedios/estoque") {
        return consultarEstoqueRemedios(conn)
    }

    app.post("/remedios") {
        return status(201, criarRemedio(conn, body()))
    }

    app.put("/remedios/:id/estoque") {
        return atualizarEstoqueRemedio(conn, param("id"), body())
    }

    // ------------------------------------------------------------------------
    // RF05 - Manter Historico de Tratamentos por Animal
    // ------------------------------------------------------------------------
    app.get("/gados/:gadoId/tratamentos") {
        return listarTratamentosPorGado(conn, param("gadoId"))
    }

    app.get("/tratamentos/:id/remedios") {
        return listarRemediosDoTratamento(conn, param("id"))
    }

    app.post("/tratamentos") {
        return status(201, registrarTratamento(conn, body()))
    }
}
