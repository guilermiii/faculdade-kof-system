package db

import models.*

// ============================================================================
// Conexao com Banco Nativo KOF SQLite e Schema (RNF02, RNF05)
// ============================================================================

String connectDb() {
    var envUrl = secrets.get("DB_URL", "")
    if (envUrl != null && envUrl != "") {
        return db.connect(envUrl)
    }
    return db.connect("sqlite:fazenda.db")
}

initSchema(String conn) {
    orm.create<Pasto>(conn)
    orm.create<Gado>(conn)
    orm.create<Remedio>(conn)
    orm.create<Tratamento>(conn)
    orm.create<TratamentoRemedio>(conn)
    orm.create<UsuarioPerfil>(conn)
}
