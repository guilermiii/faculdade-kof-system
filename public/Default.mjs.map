        }
        var gadoId = inpTratGadoManual.text()
        if (gadoId == "" && UiState.gadoIds.size() > 0) {
            gadoId = UiState.gadoIds.get(selTratGado.selected())
        }
        var remId = inpTratRemedioManual.text()
        if (remId == "" && UiState.remedioIds.size() > 0) {
            remId = UiState.remedioIds.get(selTratRemedio.selected())
        }
        var dosStr = inpTratDosagem.text()
        if (dosStr == "") {
            dosStr = "1.0"
        }
        var obs = taTratObs.text()
        if (obs == "") {
            obs = "Aplicacao supervisionada com baixa automatica no estoque."
        }
        var payload = "{\"nome_doenca\":\"" + doenca + "\",\"gado_uuid\":\"" + gadoId + "\",\"data_inicio\":\"" + inpTratInicio.text() + "\",\"data_fim\":\"" + inpTratFim.text() + "\",\"observacoes\":\"" + obs + "\",\"fk_remedio_uuid\":\"" + remId + "\",\"dosagen\":" + dosStr + "}"
        var res = http.post(UiState.apiBase + "/tratamentos", payload)
        sincronizarRemediosUi(tabelaRemedios, tabelaDashboardEstoque, selRemedioEstoque, selTratRemedio, kpiDashBaixo, kpiDashValor, kpiRemTotal, kpiRemAtivos, kpiRemBaixos, kpiRemZerados)
        carregarHistoricoGadoUi(gadoId, tabelaTratamentos, selTratamentoVer)
        statusBanner.text = "Movimentacao / tratamento registrado e estoque atualizado (RF05/RF06): " + res
    })
