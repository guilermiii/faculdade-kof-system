    inpGadoPastoManual.setId("inp-gado-pasto-manual")

    var btnCriarGado = Button("+ Adicionar Animal", () -> {
        var nome = inpGadoNome.text()
        if (nome == "") {
            nome = "Bovino Sem Nome"
        }
        var reg = inpGadoRegistro.text()
        if (reg == "") {
            reg = "BR-001"
        }
        var pastoId = inpGadoPastoManual.text()
        if (pastoId == "" && UiState.pastoIds.size() > 0) {
            pastoId = UiState.pastoIds.get(selGadoPasto.selected())
        }
        var maeId = ""
        var idxMae = selGadoMae.selected()
        if (idxMae > 0 && (idxMae - 1) < UiState.gadoIds.size()) {
            maeId = UiState.gadoIds.get(idxMae - 1)
        }
        var saude = opcoesSaude.get(selGadoSaude.selected())
        var sexo = opcoesSexo.get(selGadoSexo.selected())
        var leiteira = "true"
        if (selGadoLeiteira.selected() == 1) {
            leiteira = "false"
        }
        var payload = "{\"nome\":\"" + nome + "\",\"vaca_leitera\":" + leiteira + ",\"pasto_uuid\":\"" + pastoId + "\",\"saudeVaca\":\"" + saude + "\",\"numero_registro\":\"" + reg + "\",\"mae\":\"" + maeId + "\",\"sexo\":\"" + sexo + "\",\"historico_tratamento_uuid\":\"\",\"data_nascimento\":\"" + inpGadoNasc.text() + "\"}"
        var res = http.post(UiState.apiBase + "/gados", payload)
