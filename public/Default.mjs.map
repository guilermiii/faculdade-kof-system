        statusBanner.text = "Historico carregado para " + nomeDoGadoPorId(gadoId)
    })
    btnHistoricoGado.setClass("btn-outline")
    btnHistoricoGado.setId("btn-historico-gado")

    var btnRemediosTratamento = Button("Exportar / Ver Receituário", () -> {
        var tratId = inpTratIdManual.text()
        if (tratId == "" && UiState.tratamentoIds.size() > 0) {
            tratId = UiState.tratamentoIds.get(selTratamentoVer.selected())
        }
        var res = http.get(UiState.apiBase + "/tratamentos/" + tratId + "/remedios")
        if (res.startsWith("[")) {
            var itens = json.decode<List<TratamentoRemedioItem>>(res)
            var linhasRec: List<List<String>> = listOf()
            var k = 0
            while (k < itens.size()) {
                var it = itens.get(k)
                linhasRec.add(listOf(
                    nomeDoRemedioPorId(it.fk_remedio_uuid),
                    "" + it.dosagen + " mL / dose",
                    it.id
                ))
                k = k + 1
            }
            if (linhasRec.size() == 0) {
                linhasRec.add(listOf("Nenhum medicamento vinculado", "-", "-"))
            }
            tabelaReceituario.setRows(linhasRec)
            statusBanner.text = "Receituario carregado (" + itens.size() + " itens)."
        } else {
            statusBanner.text = "Receituario do tratamento (RF05): " + res
        }
    })
