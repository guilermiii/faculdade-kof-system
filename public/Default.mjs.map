// ============================================================================
// Estocaê / AgroKOF — Controle de Estoque Inteligente & Gestao Pecuaria
// Frontend Multiplataforma Web & Mobile 100% em KOF (RNF01, RNF06, RNF07)
// Modelo Visual: Estocaê (Figma Community)
// Targets:
//   Web (KofJS):   kof build ui/app_ui.kf --target js --output public
//   Mobile (APK):  kof build ui/app_ui.kf --target android --apk
// ============================================================================

record PastoItem(
    String id,
    String nome,
    Bool dono,
    Int valor_cabeca
)

record GadoItem(
    String id,
    String nome,
    Bool vaca_leitera,
    String pasto_uuid,
    String saudeVaca,
    String numero_registro,
    String mae,
    String sexo,
    String historico_tratamento_uuid,
    String data_nascimento
)

record RemedioItem(
    String id,
    String nome,
    String data_compra,
    String data_vencimento,
    Double valor,
    String aplicacao,
    Int estoque
)

record TratamentoItem(
    String id,
    String nome_doenca,
    String gado_uuid,
    String data_inicio,
    String data_fim,
    String observacoes
)

record TratamentoRemedioItem(
    String id,
    String fk_tratamento_uuid,
    String fk_remedio_uuid,
    Double dosagen
)

class UiState {
    static Int fontScale = 14
    static Bool darkTheme = false
    static String apiBase = ""
    static Int abaAtiva = 0
    static Int tipoMovimentacao = 0
    static Int periodoGrafico = 0

    static List<String> pastoIds = listOf()
    static List<String> pastoNomes = listOf()

    static List<String> gadoIds = listOf()
    static List<String> gadoNomes = listOf()

    static List<String> remedioIds = listOf()
    static List<String> remedioNomes = listOf()
    static List<Int> remedioEstoques = listOf()

    static List<String> tratamentoIds = listOf()
}

Int calcularEscala(Int atual, Int delta) {
    var nova = atual + delta
    if (nova > 32) {
        return 32
    }
    if (nova < 12) {
        return 12
    }
    return nova
}

String nomeDoPastoPorId(String id) {
    if (id == "") {
        return "Sem pasto"
    }
    var i = 0
    while (i < UiState.pastoIds.size()) {
        if (UiState.pastoIds.get(i) == id) {
            return UiState.pastoNomes.get(i)
        }
        i = i + 1
    }
    return id
}

String nomeDoRemedioPorId(String id) {
    if (id == "") {
        return "-"
    }
    var i = 0
    while (i < UiState.remedioIds.size()) {
        if (UiState.remedioIds.get(i) == id) {
            return UiState.remedioNomes.get(i)
        }
        i = i + 1
    }
    return id
}

String nomeDoGadoPorId(String id) {
    if (id == "") {
        return "Matriz Externa"
    }
    var i = 0
    while (i < UiState.gadoIds.size()) {
        if (UiState.gadoIds.get(i) == id) {
            return UiState.gadoNomes.get(i)
        }
        i = i + 1
    }
    return id
}

String formatarPosse(Bool dono) {
    if (dono) {
        return "Ativo (Proprio)"
    }
    return "Arrendado"
}

String formatarLeiteira(Bool leiteira) {
    if (leiteira) {
        return "Leiteira"
    }
    return "Corte / Recria"
}

String formatarAplicacao(String aplic) {
    if (aplic == "INJECAO") {
        return "Injetavel (IM/SC)"
    }
    if (aplic == "CURA_FERIDAS") {
        return "Topico / Cicatrizante"
    }
    if (aplic == "SORO_FISIOLOGICO") {
        return "Hidratacao (IV)"
    }
    return aplic
}

Column campoInput(String rotulo, Input controle) {
    var lbl = Label(rotulo)
    lbl.setClass("field-label")
    var grupo = Column(listOf(lbl, controle))
    grupo.setClass("field-group")
    return grupo
}

Column campoSelect(String rotulo, Select controle) {
    var lbl = Label(rotulo)
    lbl.setClass("field-label")
    var grupo = Column(listOf(lbl, controle))
    grupo.setClass("field-group")
    return grupo
}

Column campoTextarea(String rotulo, Textarea controle) {
    var lbl = Label(rotulo)
    lbl.setClass("field-label")
    var grupo = Column(listOf(lbl, controle))
    grupo.setClass("field-group")
    return grupo
}

Row criarSwitchRow(String titulo, String subtitulo, Bool inicialAtivo) {
    var t = Label(titulo)
    t.setClass("switch-title")
    var s = Label(subtitulo)
    s.setClass("switch-sub")
    var colTxt = Column(listOf(t, s))
    colTxt.setClass("switch-text-col")

    var estado = inicialAtivo
    var btnToggle = Button("", () -> {})
    if (estado) {
        btnToggle.setClass("estocae-switch on")
    } else {
        btnToggle.setClass("estocae-switch off")
    }
    btnToggle.on("click", (e) -> {
        estado = !estado
        if (estado) {
            btnToggle.setClass("estocae-switch on")
        } else {
            btnToggle.setClass("estocae-switch off")
        }
    })

    var linha = Row(listOf(colTxt, btnToggle))
    linha.setClass("switch-row")
    return linha
}

Row criarPaginacaoEstocae() {
    var bPrev = Button("<", () -> {})
    bPrev.setClass("page-btn")
    var b1 = Button("1", () -> {})
    b1.setClass("page-btn active")
    var b2 = Button("2", () -> {})
    b2.setClass("page-btn")
    var b3 = Button("3", () -> {})
    b3.setClass("page-btn")
    var b4 = Button("4", () -> {})
    b4.setClass("page-btn")
    var b5 = Button("5", () -> {})
    b5.setClass("page-btn")
    var bNext = Button(">", () -> {})
    bNext.setClass("page-btn")
    var pag = Row(listOf(bPrev, b1, b2, b3, b4, b5, bNext))
    pag.setClass("pagination-bar")
    return pag
}

// ============================================================================
// GRAFICOS EM CANVAS NATIVO KOF (Fiel a Imagem 1 do Prototipo Estocae)
// ============================================================================
desenharGraficoLinha(Canvas cv, Int variante) {
    cv.clearRect(0, 0, 660, 220)

    var corGrade = Color.rgba(229, 231, 235, 255)
    var corTexto = Color.rgba(107, 114, 128, 255)
    var corAzul = Color.rgba(37, 99, 235, 255)
    var corAzulArea = Color.rgba(239, 246, 255, 255)
    var corVerde = Color.rgba(16, 185, 129, 255)
    var corBranco = Color.rgba(255, 255, 255, 255)

    var yLevels = listOf(25, 55, 85, 115, 145, 175)
    var yLabels = listOf("50", "40", "30", "20", "10", "0")
    var xs = listOf(42, 141, 240, 339, 438, 537, 636)
    var meses = listOf("Jan", "Fev", "Mar", "Abr", "Mai", "Jun", "Jul")

    // Coordenadas da serie Azul (Quant. Atual de Estoque)
    var ysAzul = listOf(78, 84, 54, 53, 46, 36, 25)
    if (variante == 1) {
        ysAzul = listOf(90, 70, 62, 48, 52, 34, 28)
    }
    if (variante == 2) {
        ysAzul = listOf(64, 60, 58, 44, 40, 32, 24)
    }

    // Coordenadas da serie Verde (Estoque Ideal)
    var ysVerde = listOf(128, 134, 117, 115, 110, 105, 99)

    // 1. Preenchimento suave azul-claro sob a curva
    cv.setFill(corAzulArea)
    cv.beginPath()
    cv.moveTo(xs.get(0), 175)
    var k = 0
    while (k < 7) {
        cv.lineTo(xs.get(k), ysAzul.get(k))
        k = k + 1
    }
    cv.lineTo(xs.get(6), 175)
    cv.closePath()
    cv.fill()

    // 2. Linhas horizontais de grade e eixo Y (50, 40, 30, 20, 10, 0)
    cv.setStroke(corGrade)
    cv.setLineWidth(1)
    cv.setFill(corTexto)
    var i = 0
    while (i < 6) {
        var y = yLevels.get(i)
        cv.fillText(yLabels.get(i), 10, y + 4)
        cv.beginPath()
        cv.moveTo(42, y)
        cv.lineTo(636, y)
        cv.stroke()
        i = i + 1
    }

    // 3. Eixo X (Jan a Jul)
    var m = 0
    while (m < 7) {
        cv.fillText(meses.get(m), xs.get(m) - 10, 202)
        m = m + 1
    }

    // 4. Linha Azul (Quant. Atual de Estoque)
    cv.setStroke(corAzul)
    cv.setLineWidth(2)
    cv.beginPath()
    cv.moveTo(xs.get(0), ysAzul.get(0))
    var a = 1
    while (a < 7) {
        cv.lineTo(xs.get(a), ysAzul.get(a))
        a = a + 1
    }
    cv.stroke()

    // 5. Linha Verde (Estoque Ideal)
    cv.setStroke(corVerde)
    cv.setLineWidth(2)
    cv.beginPath()
    cv.moveTo(xs.get(0), ysVerde.get(0))
    var b = 1
    while (b < 7) {
        cv.lineTo(xs.get(b), ysVerde.get(b))
        b = b + 1
    }
    cv.stroke()

    // Marcadores circulares vazados na serie Azul e Verde
    var p = 0
    while (p < 7) {
        // Ponto Azul
        cv.setFill(corBranco)
        cv.setStroke(corAzul)
        cv.setLineWidth(2)
        cv.beginPath()
        cv.arc(xs.get(p), ysAzul.get(p), 4, 0.0, 6.28318)
        cv.fill()
        cv.stroke()

        // Ponto Verde
        cv.setFill(corBranco)
        cv.setStroke(corVerde)
        cv.setLineWidth(2)
        cv.beginPath()
        cv.arc(xs.get(p), ysVerde.get(p), 4, 0.0, 6.28318)
        cv.fill()
        cv.stroke()
        p = p + 1
    }
}

desenharGraficoDonut(Canvas cv) {
    cv.clearRect(0, 0, 220, 190)

    var cx = 110
    var cy = 95
    var raio = 64

    var corRoxo = Color.rgba(139, 92, 246, 255)
    var corAzul = Color.rgba(37, 99, 235, 255)
    var corVerde = Color.rgba(16, 185, 129, 255)
    var corLaranja = Color.rgba(245, 158, 11, 255)

    cv.setLineWidth(20)

    // Segmento 1: Roxo (40% -> de 2.6 a 5.1 rad)
    cv.setStroke(corRoxo)
    cv.beginPath()
    cv.arc(cx, cy, raio, 2.60, 5.10)
    cv.stroke()

    // Segmento 2: Azul (20% -> de 5.1 a 6.15 rad)
    cv.setStroke(corAzul)
    cv.beginPath()
    cv.arc(cx, cy, raio, 5.10, 6.15)
    cv.stroke()

    // Segmento 3: Verde (25% -> de -0.13 a 1.75 rad)
    cv.setStroke(corVerde)
    cv.beginPath()
    cv.arc(cx, cy, raio, -0.13, 1.75)
    cv.stroke()

    // Segmento 4: Laranja (15% -> de 1.75 a 2.60 rad)
    cv.setStroke(corLaranja)
    cv.beginPath()
    cv.arc(cx, cy, raio, 1.75, 2.60)
    cv.stroke()
}

// ============================================================================
// NAVEGACAO LATERAL ENTRE TELAS (6 VISOES DO ESTOCAE)
// ============================================================================
alternarTela(
    Int indice,
    Label tituloTopo,
    Column vDash,
    Column vGado,
    Column vRemedios,
    Column vPastos,
    Column vTratamentos,
    Column vSistema
) {
    UiState.abaAtiva = indice
    if (indice == 0) {
        vDash.setClass("view-screen")
        tituloTopo.text = "Dashboard Overview"
    } else {
        vDash.setClass("view-screen hidden")
    }
    if (indice == 1) {
        vGado.setClass("view-screen")
        tituloTopo.text = "Inventario de Produtos & Rebanho (RF01, RF07)"
    } else {
        vGado.setClass("view-screen hidden")
    }
    if (indice == 2) {
        vRemedios.setClass("view-screen")
        tituloTopo.text = "Controle de Estoque & Farmacia (RF03, RF06)"
    } else {
        vRemedios.setClass("view-screen hidden")
    }
    if (indice == 3) {
        vPastos.setClass("view-screen")
        tituloTopo.text = "Fornecedores, Pastos & Piquetes (RF02)"
    } else {
        vPastos.setClass("view-screen hidden")
    }
    if (indice == 4) {
        vTratamentos.setClass("view-screen")
        tituloTopo.text = "Movimentacoes & Tratamentos Sanitarios (RF05, RF06)"
    } else {
        vTratamentos.setClass("view-screen hidden")
    }
    if (indice == 5) {
        vSistema.setClass("view-screen")
        tituloTopo.text = "Configuracoes do Sistema & Perfil OAuth2 (RF04, RNF08)"
    } else {
        vSistema.setClass("view-screen hidden")
    }
}

// ============================================================================
// SINCRONIZACAO DE DADOS COM O BACKEND KOF (SQLite / PostgreSQL)
// ============================================================================
sincronizarPastosUi(
    Table tabelaPastos,
    Select selPastoEditar,
    Select selGadoPasto,
    Select selFiltroPasto,
    Label kpiDashPastos,
    Label kpiPastosTotal,
    Label kpiPastosProprios,
    Label kpiPastosArrendados,
    Label kpiPastosCusto
) {
    var res = http.get(UiState.apiBase + "/pastos")
    if (!res.startsWith("[")) {
        return
    }
    var lista = json.decode<List<PastoItem>>(res)
    var ids: List<String> = listOf()
    var nomes: List<String> = listOf()
    var opcoesSelect: List<String> = listOf()
    var linhas: List<List<String>> = listOf()
    var proprios = 0
    var somaCusto = 0

    var i = 0
    while (i < lista.size()) {
        var p = lista.get(i)
        ids.add(p.id)
        nomes.add(p.nome)
        opcoesSelect.add(p.nome + " (R$ " + p.valor_cabeca + "/cab)")
        somaCusto = somaCusto + p.valor_cabeca
        var statusStr = "Ativo"
        var fornStr = "Fazenda Propria"
        if (p.dono) {
            proprios = proprios + 1
        } else {
            statusStr = "Atenção"
            fornStr = "Arrendamento Externo"
        }
        var cod = "PST-00" + (i + 1)
        linhas.add(listOf(
            p.nome,
            cod,
            "Area de pastagem / manejo rotacionado",
            fornStr,
            formatarPosse(p.dono),
            "R$" + p.valor_cabeca + ",00",
            statusStr,
            "Editar | Excluir"
        ))
        i = i + 1
    }

    UiState.pastoIds = ids
    UiState.pastoNomes = nomes

    if (linhas.size() == 0) {
        linhas.add(listOf("Nenhum pasto cadastrado", "PST-000", "Clique em Popular Demo ou adicione acima", "-", "-", "R$0,00", "Inativo", "-"))
        opcoesSelect.add("Cadastre um pasto primeiro")
    }

    tabelaPastos.setRows(linhas)
    selPastoEditar.setOptions(opcoesSelect)
    selGadoPasto.setOptions(opcoesSelect)
    selFiltroPasto.setOptions(opcoesSelect)

    var arrendados = lista.size() - proprios
    var mediaCusto = 0
    if (lista.size() > 0) {
        mediaCusto = somaCusto / lista.size()
    }

    kpiDashPastos.text = "" + lista.size()
    kpiPastosTotal.text = "" + lista.size()
    kpiPastosProprios.text = "" + proprios
    kpiPastosArrendados.text = "" + arrendados
    kpiPastosCusto.text = "R$ " + mediaCusto
}

popularTabelaGadosUi(List<GadoItem> lista, Table tabelaGados) {
    var linhas: List<List<String>> = listOf()
    var i = 0
    while (i < lista.size()) {
        var g = lista.get(i)
        var statusBadge = "Ativo"
        if (g.saudeVaca == "DOENTE" || g.saudeVaca == "MORTA") {
            statusBadge = "Inativo"
        }
        if (g.saudeVaca == "RECUPERACAO") {
            statusBadge = "Atenção"
        }
        linhas.add(listOf(
            g.nome,
            g.numero_registro,
            "Nasc: " + g.data_nascimento + " · Mae: " + nomeDoGadoPorId(g.mae),
            nomeDoPastoPorId(g.pasto_uuid),
            formatarLeiteira(g.vaca_leitera),
            g.sexo,
            statusBadge,
            "Editar | Excluir"
        ))
        i = i + 1
    }
    if (linhas.size() == 0) {
        linhas.add(listOf("Nenhum animal encontrado", "PRD-000", "Sem registros para o filtro selecionado", "-", "-", "-", "Inativo", "-"))
    }
    tabelaGados.setRows(linhas)
}

sincronizarGadosUi(
    Table tabelaGados,
    Select selGadoEditar,
    Select selGadoMae,
    Select selTratGado,
    Label kpiDashProdutos,
    Label kpiGadoTotal,
    Label kpiGadoAtivos,
    Label kpiGadoInativos,
    Label kpiGadoAlerta
) {
    var res = http.get(UiState.apiBase + "/gados")
    if (!res.startsWith("[")) {
        return
    }
    var lista = json.decode<List<GadoItem>>(res)
    var ids: List<String> = listOf()
    var nomes: List<String> = listOf()
    var opcoesAnimal: List<String> = listOf()
    var opcoesMae: List<String> = listOf("Nenhuma (Matriz Externa)")
    var saudaveis = 0
    var doentes = 0
    var recuperacao = 0

    var i = 0
    while (i < lista.size()) {
        var g = lista.get(i)
        ids.add(g.id)
        nomes.add(g.nome + " [" + g.numero_registro + "]")
        opcoesAnimal.add(g.nome + " (" + g.numero_registro + " · " + g.saudeVaca + ")")
        opcoesMae.add(g.nome + " (" + g.numero_registro + ")")
        if (g.saudeVaca == "SAUDAVEL") {
            saudaveis = saudaveis + 1
        } else {
            if (g.saudeVaca == "RECUPERACAO") {
                recuperacao = recuperacao + 1
            } else {
                doentes = doentes + 1
            }
        }
        i = i + 1
    }

    UiState.gadoIds = ids
    UiState.gadoNomes = nomes

    if (opcoesAnimal.size() == 0) {
        opcoesAnimal.add("Cadastre um animal primeiro")
    }

    popularTabelaGadosUi(lista, tabelaGados)
    selGadoEditar.setOptions(opcoesAnimal)
    selGadoMae.setOptions(opcoesMae)
    selTratGado.setOptions(opcoesAnimal)

    kpiDashProdutos.text = "" + lista.size()
    kpiGadoTotal.text = "" + lista.size()
    kpiGadoAtivos.text = "" + saudaveis
    kpiGadoInativos.text = "" + doentes
    kpiGadoAlerta.text = "" + recuperacao
}

sincronizarRemediosUi(
    Table tabelaRemedios,
    Table tabelaDashboardEstoque,
    Select selRemedioEstoque,
    Select selTratRemedio,
    Label kpiDashBaixo,
    Label kpiDashValor,
    Label kpiRemTotal,
    Label kpiRemAtivos,
    Label kpiRemBaixos,
    Label kpiRemZerados
) {
    var res = http.get(UiState.apiBase + "/remedios/estoque")
    if (!res.startsWith("[")) {
        return
    }
    var lista = json.decode<List<RemedioItem>>(res)
    var ids: List<String> = listOf()
    var nomes: List<String> = listOf()
    var estoques: List<Int> = listOf()
    var opcoesRemedio: List<String> = listOf()
    var linhasInv: List<List<String>> = listOf()
    var linhasDash: List<List<String>> = listOf()

    var estaveis = 0
    var baixos = 0
    var zerados = 0
    var valorTotalInt = 0

    var i = 0
    while (i < lista.size()) {
        var r = lista.get(i)
        ids.add(r.id)
        nomes.add(r.nome)
        estoques.add(r.estoque)
        opcoesRemedio.add(r.nome + " (Estoque: " + r.estoque + " un.)")

        var custoItem = (r.valor as Int) * r.estoque
        valorTotalInt = valorTotalInt + custoItem

        var statusDash = "Estável"
        var statusInv = "Ativo"
        if (r.estoque == 0) {
            zerados = zerados + 1
            baixos = baixos + 1
            statusDash = "Crítico"
            statusInv = "Inativo"
        } else {
            if (r.estoque <= 5) {
                baixos = baixos + 1
                statusDash = "Crítico"
                statusInv = "Inativo"
            } else {
                if (r.estoque <= 15) {
                    estaveis = estaveis + 1
                    statusDash = "Atenção"
                    statusInv = "Ativo"
                } else {
                    estaveis = estaveis + 1
                }
            }
        }

        var cod = "PRD-00" + (i + 1)
        linhasDash.add(listOf(
            r.nome + " (#SKU - " + (1000 + i * 211) + ")",
            cod,
            formatarAplicacao(r.aplicacao),
            "" + r.estoque + " unidades",
            statusDash
        ))

        linhasInv.add(listOf(
            r.nome,
            cod,
            "Compra: " + r.data_compra + " · Validade: " + r.data_vencimento,
            "Distribuidora Vet Alfa",
            formatarAplicacao(r.aplicacao),
            "R$" + r.valor,
            "" + r.estoque + " unidades",
            statusInv,
            "Editar | Excluir"
        ))
        i = i + 1
    }

    UiState.remedioIds = ids
    UiState.remedioNomes = nomes
    UiState.remedioEstoques = estoques

    if (linhasInv.size() == 0) {
        linhasInv.add(listOf("Nenhum medicamento em estoque", "PRD-000", "-", "-", "-", "R$0,00", "0 unidades", "Inativo", "-"))
        linhasDash.add(listOf("Nenhum item em estoque", "PRD-000", "-", "0 unidades", "Crítico"))
        opcoesRemedio.add("Cadastre um medicamento primeiro")
    }

    tabelaRemedios.setRows(linhasInv)
    tabelaDashboardEstoque.setRows(linhasDash)
    selRemedioEstoque.setOptions(opcoesRemedio)
    selTratRemedio.setOptions(opcoesRemedio)

    kpiDashBaixo.text = "" + baixos
    kpiDashValor.text = "R$ " + valorTotalInt + ",00"
    kpiRemTotal.text = "" + lista.size()
    kpiRemAtivos.text = "" + estaveis
    kpiRemBaixos.text = "" + baixos
    kpiRemZerados.text = "" + zerados
}

carregarHistoricoGadoUi(
    String gadoId,
    Table tabelaTratamentos,
    Select selTratamentoVer
) {
    if (gadoId == "") {
        return
    }
    var res = http.get(UiState.apiBase + "/gados/" + gadoId + "/tratamentos")
    if (!res.startsWith("[")) {
        return
    }
    var lista = json.decode<List<TratamentoItem>>(res)
    var ids: List<String> = listOf()
    var opcoesTrat: List<String> = listOf()
    var linhas: List<List<String>> = listOf()

    var estoqueRef = 25
    if (UiState.remedioEstoques.size() > 0) {
        estoqueRef = UiState.remedioEstoques.get(0)
    }

    var i = 0
    while (i < lista.size()) {
        var t = lista.get(i)
        ids.add(t.id)
        opcoesTrat.add(t.nome_doenca + " (" + t.data_inicio + ")")
        linhas.add(listOf(
            t.data_inicio + " 15:57",
            "Saída",
            nomeDoGadoPorId(t.gado_uuid),
            "-1",
            "" + estoqueRef,
            "Juliana Albuquerque",
            t.nome_doenca,
            "Ver | Excluir"
        ))
        i = i + 1
    }

    UiState.tratamentoIds = ids
    if (linhas.size() == 0) {
        linhas.add(listOf("29/04/2025 15:57", "Entrada", nomeDoGadoPorId(gadoId), "+10", "" + estoqueRef, "Juliana Albuquerque", "Sem tratamentos registrados", "Ver | Excluir"))
        opcoesTrat.add("Sem tratamentos registrados")
    }

    tabelaTratamentos.setRows(linhas)
    selTratamentoVer.setOptions(opcoesTrat)
}

