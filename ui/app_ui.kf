    // ABA 5: PERFIL DO USUARIO AUTENTICADO VIA OAUTH2 (RF04, RNF08, RNF09)
    // ========================================================================
    var inpPerfilNome = Input("")
    inpPerfilNome.setPlaceholder("Ex: Guilherme Silva (Gestor Agropecuario)")
    inpPerfilNome.setId("inp-perfil-nome")

    var inpPerfilEmail = Input("")
    inpPerfilEmail.setPlaceholder("Ex: gestor@fazendakof.com.br")
    inpPerfilEmail.setId("inp-perfil-email")

    var tabelaPerfil = Table(
        listOf("Propriedade", "Valor na Sessao OAuth2"),
        listOf(
            listOf("Provedores Suportados (RNF08)", "Google OAuth2 / GitHub OAuth2"),
            listOf("Politica de Privacidade (RNF09)", "Coleta estrita de ID, Nome, E-mail e Provedor"),
            listOf("Status da Sessao Atual", "Clique em 'Consultar Sessao OAuth2' para verificar")
        )
    )
    tabelaPerfil.setId("tabela-perfil")

    var btnPerfilOAuth = Button("Consultar Sessao OAuth2", () -> {
        var res = http.get(UiState.apiBase + "/perfil")
        tabelaPerfil.setRows(listOf(
            listOf("Provedores Suportados (RNF08)", "Google OAuth2 / GitHub OAuth2"),
            listOf("Politica de Privacidade (RNF09)", "Coleta minima sem rastreamento"),
            listOf("Resposta da API (/perfil)", res)
        ))
        statusBanner.text = "Verificacao de Perfil OAuth2 (RF04/RNF08): " + res
    })
    btnPerfilOAuth.setClass("btn-secondary")
    btnPerfilOAuth.setId("btn-consultar-perfil")

    var btnAtualizarPerfil = Button("Salvar Dados do Perfil", () -> {
        var payload = "{\"nome\":\"" + inpPerfilNome.text() + "\",\"email\":\"" + inpPerfilEmail.text() + "\"}"
        var res = http.put(UiState.apiBase + "/perfil", payload)
        tabelaPerfil.setRows(listOf(
            listOf("Nome Informado", inpPerfilNome.text()),
            listOf("E-mail Informado", inpPerfilEmail.text()),
            listOf("Retorno do Servidor (/perfil)", res)
        ))
        statusBanner.text = "Atualizacao de Perfil OAuth2 (RF04/RNF09): " + res
    })
    btnAtualizarPerfil.setClass("btn-primary")
    btnAtualizarPerfil.setId("btn-salvar-perfil")

    var formPerfil = Fieldset(
        listOf(
            campoInput("Nome Completo do Produtor / Gestor", inpPerfilNome),
            campoInput("E-mail Institucional (Vinculado ao OAuth2)", inpPerfilEmail),
            Row(listOf(btnPerfilOAuth, btnAtualizarPerfil))
        ),
        "Dados da Conta OAuth2 — Google / GitHub (RF04, RNF08, RNF09)"
    )
    formPerfil.setClass("panel-card form-card")

    var cardTabelaPerfil = Fieldset(
        listOf(tabelaPerfil),
        "Auditoria de Seguranca e Privacidade (RNF08, RNF09)"
    )
    cardTabelaPerfil.setClass("panel-card table-card")

    var painelPerfil = Row(listOf(formPerfil, cardTabelaPerfil))
    painelPerfil.setClass("tab-panel hidden")
    painelPerfil.setId("panel-perfil")

    // ========================================================================
    // 4. BARRA DE NAVEGACAO POR ABAS E CONTROLES DE TOPO
    // ========================================================================
    var btnAbaPastos = Button("1. Pastos & Piquetes", () -> {
        alternarAba(0, painelPastos, painelGado, painelRemedios, painelTratamentos, painelPerfil)
    })
    var btnAbaGado = Button("2. Rebanho & Filtro", () -> {
        alternarAba(1, painelPastos, painelGado, painelRemedios, painelTratamentos, painelPerfil)
    })
    var btnAbaRemedios = Button("3. Farmacia & Estoque", () -> {
        alternarAba(2, painelPastos, painelGado, painelRemedios, painelTratamentos, painelPerfil)
    })
    var btnAbaTratamentos = Button("4. Tratamentos Sanitarios", () -> {
        alternarAba(3, painelPastos, painelGado, painelRemedios, painelTratamentos, painelPerfil)
    })
    var btnAbaPerfil = Button("5. Conta OAuth2", () -> {
        alternarAba(4, painelPastos, painelGado, painelRemedios, painelTratamentos, painelPerfil)
    })

    btnAbaPastos.setClass("tab-btn active")
    btnAbaGado.setClass("tab-btn")
    btnAbaRemedios.setClass("tab-btn")
    btnAbaTratamentos.setClass("tab-btn")
    btnAbaPerfil.setClass("tab-btn")

    btnAbaPastos.setId("tab-pastos")
    btnAbaGado.setId("tab-gado")
    btnAbaRemedios.setId("tab-remedios")
    btnAbaTratamentos.setId("tab-tratamentos")
    btnAbaPerfil.setId("tab-perfil")

    var navTabs = Row(listOf(btnAbaPastos, btnAbaGado, btnAbaRemedios, btnAbaTratamentos, btnAbaPerfil))
    navTabs.setClass("tabs-bar")

    // Controles do Header: Sincronizar, Popular Demo, Acessibilidade (A-, A+, Tema)
    var btnSync = Button("Sincronizar Dados", () -> {
        sincronizarPastosUi(tabelaPastos, selPastoEditar, selGadoPasto, selFiltroPasto, kpiPastosValor, kpiPastosSub)
        sincronizarGadosUi(tabelaGados, selGadoEditar, selGadoMae, selTratGado, kpiGadosValor, kpiGadosSub)
        sincronizarRemediosUi(tabelaRemedios, selRemedioEstoque, selTratRemedio, kpiRemediosValor, kpiRemediosSub)
        if (UiState.gadoIds.size() > 0) {
            carregarHistoricoGadoUi(UiState.gadoIds.get(0), tabelaTratamentos, selTratamentoVer, kpiTratValor, kpiTratSub)
        }
        statusBanner.text = "Painel sincronizado: " + UiState.pastoIds.size() + " pastos, " + UiState.gadoIds.size() + " animais e " + UiState.remedioIds.size() + " medicamentos."
    })
    btnSync.setClass("btn-secondary")
    btnSync.setId("btn-sync")

    var btnSeedDemo = Button("Popular Fazenda Demo", () -> {
        http.post(UiState.apiBase + "/pastos", "{\"nome\":\"Piquete Santa Helena\",\"dono\":true,\"valor_cabeca\":140}")
        http.post(UiState.apiBase + "/pastos", "{\"nome\":\"Pasto da Represa\",\"dono\":false,\"valor_cabeca\":185}")
        sincronizarPastosUi(tabelaPastos, selPastoEditar, selGadoPasto, selFiltroPasto, kpiPastosValor, kpiPastosSub)

        var p1 = ""
        if (UiState.pastoIds.size() > 0) {
            p1 = UiState.pastoIds.get(0)
        }
        http.post(UiState.apiBase + "/gados", "{\"nome\":\"Mimosa\",\"vaca_leitera\":true,\"pasto_uuid\":\"" + p1 + "\",\"saudeVaca\":\"SAUDAVEL\",\"numero_registro\":\"BR-101\",\"mae\":\"\",\"sexo\":\"FEMEA\",\"historico_tratamento_uuid\":\"\",\"data_nascimento\":\"2022-04-12\"}")
        http.post(UiState.apiBase + "/gados", "{\"nome\":\"Estrela\",\"vaca_leitera\":true,\"pasto_uuid\":\"" + p1 + "\",\"saudeVaca\":\"RECUPERACAO\",\"numero_registro\":\"BR-102\",\"mae\":\"\",\"sexo\":\"FEMEA\",\"historico_tratamento_uuid\":\"\",\"data_nascimento\":\"2023-08-20\"}")
        sincronizarGadosUi(tabelaGados, selGadoEditar, selGadoMae, selTratGado, kpiGadosValor, kpiGadosSub)

        http.post(UiState.apiBase + "/remedios", "{\"nome\":\"Ivermectina 1% Ourofino\",\"data_compra\":\"2026-01-15\",\"data_vencimento\":\"2027-12-31\",\"valor\":54.9,\"aplicacao\":\"INJECAO\",\"estoque\":30}")
        http.post(UiState.apiBase + "/remedios", "{\"nome\":\"Spray Cicatrizante Prata\",\"data_compra\":\"2026-02-10\",\"data_vencimento\":\"2028-02-10\",\"valor\":32.0,\"aplicacao\":\"CURA_FERIDAS\",\"estoque\":15}")
        sincronizarRemediosUi(tabelaRemedios, selRemedioEstoque, selTratRemedio, kpiRemediosValor, kpiRemediosSub)

        if (UiState.gadoIds.size() > 0 && UiState.remedioIds.size() > 0) {
            var gId = UiState.gadoIds.get(0)
            var rId = UiState.remedioIds.get(0)
            http.post(UiState.apiBase + "/tratamentos", "{\"nome_doenca\":\"Controle Preventivo de Parasitas\",\"gado_uuid\":\"" + gId + "\",\"data_inicio\":\"2026-10-17\",\"data_fim\":\"2026-10-20\",\"observacoes\":\"Dose unica subcutanea aplicada no manejo matinal.\",\"fk_remedio_uuid\":\"" + rId + "\",\"dosagen\":10.0}")
            sincronizarRemediosUi(tabelaRemedios, selRemedioEstoque, selTratRemedio, kpiRemediosValor, kpiRemediosSub)
            carregarHistoricoGadoUi(gId, tabelaTratamentos, selTratamentoVer, kpiTratValor, kpiTratSub)
        }
        statusBanner.text = "Fazenda Demo carregada com sucesso! Todos os pastos, animais, medicamentos e tratamentos foram populados."
    })
    btnSeedDemo.setClass("btn-primary")
    btnSeedDemo.setId("btn-seed-demo")

    var btnDiminuirFonte = Button("A-", () -> {
        UiState.fontScale = calcularEscala(UiState.fontScale, -2)
        brandTitle.fontSize = UiState.fontScale + 7
        brandSubtitle.fontSize = UiState.fontScale - 1
        statusBanner.fontSize = UiState.fontScale
        statusBanner.text = "Acessibilidade (RNF07): Escala tipografica ajustada para " + UiState.fontScale + "px"
    })
    btnDiminuirFonte.setClass("btn-icon")
    btnDiminuirFonte.setId("btn-font-dec")

    var btnAumentarFonte = Button("A+", () -> {
        UiState.fontScale = calcularEscala(UiState.fontScale, 2)
        brandTitle.fontSize = UiState.fontScale + 7
        brandSubtitle.fontSize = UiState.fontScale - 1
        statusBanner.fontSize = UiState.fontScale
        statusBanner.text = "Acessibilidade (RNF07): Escala tipografica ajustada para " + UiState.fontScale + "px"
    })
    btnAumentarFonte.setClass("btn-icon")
    btnAumentarFonte.setId("btn-font-inc")

    var btnAlternarTema = Button("Tema Claro / Escuro", () -> {
        UiState.darkTheme = !UiState.darkTheme
        if (UiState.darkTheme) {
            w.theme = Theme.dark()
            statusBanner.text = "Acessibilidade (RNF06): Tema Escuro (Dark Slate) ativado."
        } else {
            w.theme = Theme.light()
            statusBanner.text = "Acessibilidade (RNF06): Tema Claro de Alto Contraste ativado."
        }
    })
    btnAlternarTema.setClass("btn-icon")
    btnAlternarTema.setId("btn-theme-toggle")

    var headerActions = Row(listOf(btnSeedDemo, btnSync, btnDiminuirFonte, btnAumentarFonte, btnAlternarTema))
    headerActions.setClass("header-actions")

    var topbar = Row(listOf(brandCol, headerActions))
    topbar.setClass("app-topbar")

    var shell = Column(listOf(
        topbar,
        kpiGrid,
        statusBanner,
        navTabs,
        painelPastos,
        painelGado,
        painelRemedios,
        painelTratamentos,
        painelPerfil
    ))
    shell.setClass("app-shell")

    w.bind(shell)
    w.show()
}
