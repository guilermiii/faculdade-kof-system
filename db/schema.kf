package db

import models.*

// ============================================================================
// Conexao PostgreSQL e Schema (RNF02, RNF05)
// ============================================================================

String connectDb() {
    var url = secrets.get("DB_URL", "jdbc:postgresql://localhost:5432/kof_gado")
    var user = secrets.get("DB_USER", "postgres")
    var pass = secrets.get("DB_PASS", "postgres")
    return db.connect(url, user, pass)
}

initSchema(String conn) {
    orm.create<Pasto>(conn)
    orm.create<Gado>(conn)
    orm.create<Remedio>(conn)
    orm.create<Tratamento>(conn)
    orm.create<TratamentoRemedio>(conn)
    orm.create<UsuarioPerfil>(conn)
}
