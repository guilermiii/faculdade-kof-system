    var btnAumentarFonte = Button("A+", () -> {
        UiState.fontScale = calcularEscala(UiState.fontScale, 2)
        pageTitle.fontSize = UiState.fontScale + 6
        statusBanner.fontSize = UiState.fontScale
        statusBanner.text = "Acessibilidade (RNF07): Escala tipográfica ajustada para " + UiState.fontScale + "px"
    })
    btnAumentarFonte.setClass("btn-top-chip")
    btnAumentarFonte.setId("btn-font-inc")

    var btnAlternarTema = Button("Tema", () -> {
        UiState.darkTheme = !UiState.darkTheme
        if (UiState.darkTheme) {
            w.theme = Theme.dark()
            statusBanner.text = "Acessibilidade (RNF06): Tema Escuro ativado."
        } else {
            w.theme = Theme.light()
            statusBanner.text = "Acessibilidade (RNF06): Tema Claro Estocaê ativado."
        }
    })
    btnAlternarTema.setClass("btn-top-chip")
    btnAlternarTema.setId("btn-theme-toggle")

    var notifBell = Column(listOf(Icon("mail", 18)))
    notifBell.setClass("topbar-bell-btn")

    var topbarRight = Row(listOf(searchBox, btnSeedDemo, btnSync, btnDiminuirFonte, btnAumentarFonte, btnAlternarTema, notifBell))
    topbarRight.setClass("topbar-right")

    var topbar = Row(listOf(pageTitle, topbarRight))
    topbar.setClass("estocae-topbar")

    // Botoes da Sidebar Esquerda
    var btnNavDashboard = Button("🏠   Dashboard", () -> {
        alternarTela(0, pageTitle, painelDashboard, painelGado, painelRemedios, painelPastos, painelTratamentos, painelPerfil)
    })
    var btnAbaGado = Button("📦   Produtos", () -> {
        alternarTela(1, pageTitle, painelDashboard, painelGado, painelRemedios, painelPastos, painelTratamentos, painelPerfil)
    })
    var btnAbaRemedios = Button("🏢   Estoque", () -> {
        alternarTela(2, pageTitle, painelDashboard, painelGado, painelRemedios, painelPastos, painelTratamentos, painelPerfil)
    })
    var btnAbaPastos = Button("🚚   Fornecedores", () -> {
        alternarTela(3, pageTitle, painelDashboard, painelGado, painelRemedios, painelPastos, painelTratamentos, painelPerfil)
    })
    var btnAbaTratamentos = Button("💲   Movimentações", () -> {
        alternarTela(4, pageTitle, painelDashboard, painelGado, painelRemedios, painelPastos, painelTratamentos, painelPerfil)
    })
    var btnNavSistema = Button("⚙   Sistema", () -> {
        alternarTela(5, pageTitle, painelDashboard, painelGado, painelRemedios, painelPastos, painelTratamentos, painelPerfil)
    })
    var btnAbaPerfil = Button("👥   Usuários", () -> {
        alternarTela(5, pageTitle, painelDashboard, painelGado, painelRemedios, painelPastos, painelTratamentos, painelPerfil)
    })

    btnVerTodosEstoque.on("click", (e) -> {
        alternarTela(2, pageTitle, painelDashboard, painelGado, painelRemedios, painelPastos, painelTratamentos, painelPerfil)
    })

    btnNavDashboard.setClass("tab-btn sidebar-link active")
    btnAbaGado.setClass("tab-btn sidebar-link")
    btnAbaRemedios.setClass("tab-btn sidebar-link")
    btnAbaPastos.setClass("tab-btn sidebar-link")
    btnAbaTratamentos.setClass("tab-btn sidebar-link")
    btnNavSistema.setClass("tab-btn sidebar-link")
    btnAbaPerfil.setClass("tab-btn sidebar-link")

    btnNavDashboard.setId("tab-dashboard")
    btnAbaPastos.setId("tab-pastos")
    btnAbaGado.setId("tab-gado")
    btnAbaRemedios.setId("tab-remedios")
    btnAbaTratamentos.setId("tab-tratamentos")
    btnNavSistema.setId("tab-sistema")
    btnAbaPerfil.setId("tab-perfil")

    // Logo Estocaê na Sidebar
    var logoCube = Label("❖")
    logoCube.setClass("estocae-logo-cube")
    var logoBrandText = Label("Estocaê")
    logoBrandText.setClass("estocae-logo-text")
    var logoHeader = Row(listOf(logoCube, logoBrandText))
    logoHeader.setClass("estocae-sidebar-brand")

    var lblMenuPrincipal = Label("MENU PRINCIPAL")
    lblMenuPrincipal.setClass("sidebar-section-label")

    var lblMenuConfig = Label("CONFIGURAÇÕES")
    lblMenuConfig.setClass("sidebar-section-label")

    var navGroup = Column(listOf(
        lblMenuPrincipal,
        btnNavDashboard,
        btnAbaGado,
        btnAbaRemedios,
        btnAbaPastos,
        btnAbaTratamentos,
        lblMenuConfig,
        btnNavSistema,
        btnAbaPerfil
    ))
    navGroup.setClass("sidebar-nav-list")

    // Rodape do Usuario na Sidebar
    var sidebarAvatar = Label("JA")
    sidebarAvatar.setClass("sidebar-user-avatar")
    var lblSidebarRole = Label("Admin · AgroKOF")
    lblSidebarRole.setClass("sidebar-user-role")
    var sidebarUserInfo = Column(listOf(lblSidebarUserName, lblSidebarRole))
    sidebarUserInfo.setClass("sidebar-user-info")
    var sidebarFooter = Row(listOf(sidebarAvatar, sidebarUserInfo))
    sidebarFooter.setClass("sidebar-user-footer")

    var sidebar = Column(listOf(logoHeader, navGroup, sidebarFooter))
    sidebar.setClass("estocae-sidebar")

    var contentViewport = Column(listOf(
        topbar,
        statusBanner,
        painelDashboard,
        painelGado,
        painelRemedios,
        painelPastos,
        painelTratamentos,
        painelPerfil
    ))
    contentViewport.setClass("estocae-main-area")

    var appLayout = Row(listOf(sidebar, contentViewport))
    appLayout.setClass("estocae-app-shell")

    w.bind(appLayout)
    w.show()
}
